# Copy to .env for local development. On the server, deploy/setup.sh writes /etc/invisen/api.env.
DATABASE_URL=postgres://invisen:invisen@localhost:5432/invisen
PORT=3000
# Fixed OTP for local development (ignored when NODE_ENV=production)
OTP_DEV_CODE=000000
OTP_SECRET=change-me
CORS_ORIGINS=capacitor://localhost,http://localhost:5173

# SMS: console (prints code to log) | nhncloud
SMS_PROVIDER=console
NHN_SMS_APP_KEY=
NHN_SMS_SECRET_KEY=
NHN_SMS_SENDER=

# APNs (push to managers). Leave empty to disable.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_FILE=
APNS_TOPIC=com.invisen.worker
APNS_PRODUCTION=false

# Dooray/Slack-style incoming webhook for SOS and danger alerts
ALERT_WEBHOOK_URL=
